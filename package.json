{
  "name": "teleport-contest",
  "version": "1.0.0",
  "description": "The Teleport Coding Challenge — Port NetHack C to JavaScript",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-reporter=dot $(find test -maxdepth 1 -type f -name '*.test.js' -print | sort)",
    "score": "bash frozen/score.sh",
    "score:engine": "node frozen/ps_test_runner.mjs sessions",
    "generate:monster-growth": "node scripts/generate-monster-growth-data.mjs",
    "play": "echo 'Open index.html in a browser to play'"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
