{
  "name": "teleport-contest",
  "version": "1.0.0",
  "description": "The Teleport Coding Challenge — Port NetHack C to JavaScript",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-reporter=dot test/*.test.js",
    "score": "bash frozen/score.sh",
    "score:engine": "TELEPORT_DISABLE_FIXTURES=1 node frozen/ps_test_runner.mjs sessions",
    "audit:bridge-free": "node scripts/audit-bridge-free.mjs",
    "generate:monster-growth": "node scripts/generate-monster-growth-data.mjs",
    "play": "echo 'Open index.html in a browser to play'"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
